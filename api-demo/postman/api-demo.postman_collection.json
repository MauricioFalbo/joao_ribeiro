{
  "info": {
    "name": "API Demo - Luminárias Inteligentes",
    "description": "Collection para praticar REST no Postman: filtros por query, ids por params, CRUD e autenticação (401 vs 403).\n\nAntes de começar: selecione o environment 'API Demo - Local' e rode `npm start` na pasta api-demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Básico",
      "item": [
        {
          "name": "Lista de rotas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          }
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"API está UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restaurar dados iniciais",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reset"
              ]
            },
            "description": "Use entre demonstrações para voltar aos 8 dispositivos originais."
          }
        }
      ]
    },
    {
      "name": "1. Query string (filtros)",
      "item": [
        {
          "name": "Todos os dispositivos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            }
          }
        },
        {
          "name": "Por cidade",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?city=Lisboa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Lisboa"
                }
              ]
            }
          }
        },
        {
          "name": "Em falha num país",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?status=fault&country=PT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "fault"
                },
                {
                  "key": "country",
                  "value": "PT"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos estão em falha\", () => pm.response.json().data.forEach(d => pm.expect(d.status).to.eql(\"fault\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Luminárias com dim >= 50, ordenadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?type=luminaria&minDim=50&sort=dimLevel&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "luminaria"
                },
                {
                  "key": "minDim",
                  "value": "50"
                },
                {
                  "key": "sort",
                  "value": "dimLevel"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Pesquisa por nome",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?q=MAD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "MAD"
                }
              ]
            }
          }
        },
        {
          "name": "Paginação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?page=2&limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            },
            "description": "Veja também o header de resposta X-Total-Count."
          }
        },
        {
          "name": "Filtro inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?status=xpto",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "xpto"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Params (ids)",
      "item": [
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "2",
                  "description": "Id do dispositivo"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Id inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Id inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Params + query juntos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cities/Porto/devices?status=on",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cities",
                "Porto",
                "devices"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "on"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. CRUD",
      "item": [
        {
          "name": "Criar dispositivo (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LUM-FAR-{{$randomInt}}\",\n  \"city\": \"Faro\",\n  \"country\": \"PT\",\n  \"type\": \"luminaria\",\n  \"status\": \"on\",\n  \"dimLevel\": 70\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"newId\", body.id);",
                  "pm.test(\"Header Location presente\", () => pm.response.to.have.header(\"Location\"));",
                  "console.log(\"Novo id guardado em {{newId}}:\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ler o criado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/{{newId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "{{newId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar parcial - PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/{{newId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "{{newId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dimLevel\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Substituir completo - PUT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/{{newId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "{{newId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LUM-FAR-EDITADO\",\n  \"city\": \"Faro\",\n  \"country\": \"PT\",\n  \"type\": \"luminaria\",\n  \"status\": \"off\",\n  \"dimLevel\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Apagar (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/{{newId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "{{newId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro de validação (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"status\": \"broken\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Nome duplicado (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LUM-LIS-0001\",\n  \"city\": \"Lisboa\",\n  \"country\": \"PT\",\n  \"type\": \"luminaria\",\n  \"status\": \"on\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Upload de arquivo (multipart)",
      "item": [
        {
          "name": "Enviar arquivo (201)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/2/attachments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "2",
                "attachments"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Clique em Select Files e escolha um PNG, JPEG, PDF, CSV ou TXT (até 2 MB)"
                },
                {
                  "key": "description",
                  "type": "text",
                  "value": "Foto da avaria"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"attachmentId\", body.id);",
                  "pm.test(\"Header Location presente\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar anexos do dispositivo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/2/attachments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "2",
                "attachments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Baixar o arquivo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attachments/{{attachmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attachments",
                "{{attachmentId}}"
              ]
            },
            "description": "Use 'Send and Download' para salvar o arquivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sem arquivo (400)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices/2/attachments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "2",
                "attachments"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "description",
                  "type": "text",
                  "value": "sem arquivo"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "JSON em vez de multipart (415)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/2/attachments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "devices",
                "2",
                "attachments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file\": \"foto.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 415\", () => pm.response.to.have.status(415));"
                ]
              }
            }
          ]
        },
        {
          "name": "Apagar anexo (204)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/attachments/{{attachmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attachments",
                "{{attachmentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Autenticação (401 vs 403)",
      "item": [
        {
          "name": "Sem token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/secure/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "secure",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401 - sem header\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Formato errado, sem 'Bearer' (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{tokenLeitor}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/secure/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "secure",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401 - formato\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token inválido (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/secure/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "secure",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token-que-nao-existe",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401 - token inválido\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leitor: quem sou eu (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/secure/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "secure",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenLeitor}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leitor: relatório de falhas (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/secure/reports/faults",
              "host": [
                "{{baseUrl}}"
